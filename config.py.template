# Your Oura API personal access token (requires 'sleep' and 'daily' scopes)
OURA_TOKEN = "OURA_PERSONAL_ACCESS_TOKEN"

# Path where the generated iCalendar (.ics) file will be saved
ICAL_OUTPUT_PATH = "./bedtime.ics"

# --- Wake times -------------------------------------------------------------

# Where wake times come from. "fixed" uses the three times below.
# Future sources (e.g. "calendar", deriving the wake time from your first
# appointment) plug in here without touching the rest of the app.
WAKE_SOURCE = "fixed"

# Wake times as "HH:MM", local time. Monday-Friday, Saturday and Sunday are
# configured separately so a later weekend start doesn't drag your weekday
# bedtime around.
WAKE_TIME_WEEKDAY = "06:30"
WAKE_TIME_SATURDAY = "08:00"
WAKE_TIME_SUNDAY = "08:00"

# Optional per-day overrides for the days that don't fit the pattern — a late
# Wednesday lecture, an early Friday shift. Leave a day as None and it uses
# WAKE_TIME_WEEKDAY above. Saturday and Sunday are set by the two lines above.
WAKE_TIME_MONDAY = None
WAKE_TIME_TUESDAY = None
WAKE_TIME_WEDNESDAY = None
WAKE_TIME_THURSDAY = None
WAKE_TIME_FRIDAY = None

# --- Bedtimes ---------------------------------------------------------------

# Where bedtimes come from.
#   "computed" - back-calculated from your wake time, sleep need and debt
#   "fixed"    - taken from the BED_TIME_* settings below
BED_SOURCE = "computed"

# Fixed bedtimes as "HH:MM", local time. Only used when BED_SOURCE = "fixed".
# The day names the EVENING you go to bed, not the morning you get up:
# BED_TIME_MONDAY is when you turn in on Monday night, waking Tuesday.
# A time before noon is read as the small hours of the next morning, so
# "00:30" on Friday means half past midnight on Saturday.
BED_TIME_WEEKDAY = "23:00"
BED_TIME_SATURDAY = "23:30"
BED_TIME_SUNDAY = "22:30"

# Optional per-day overrides, same as the wake times. Leave a day as None and
# it uses BED_TIME_WEEKDAY above.
BED_TIME_MONDAY = None
BED_TIME_TUESDAY = None
BED_TIME_WEDNESDAY = None
BED_TIME_THURSDAY = None
BED_TIME_FRIDAY = None

# --- Personal sleep need ----------------------------------------------------

# How many days of Oura history to learn your personal sleep need from.
# 60-90 days gives a stable estimate without dragging in an old season.
HISTORY_DAYS = 90

# A night counts as "good" when its Oura sleep score is at least this value.
# Your sleep need is the median time you actually slept on good nights.
GOOD_SLEEP_SCORE = 80

# Minimum number of good nights required before the personal estimate is
# trusted. Below this, FALLBACK_SLEEP_NEED_HOURS is used instead.
MIN_GOOD_NIGHTS = 5

# Sleep need to fall back on when there isn't enough history yet.
FALLBACK_SLEEP_NEED_HOURS = 8.0

# --- Sleep debt -------------------------------------------------------------

# Rolling window (in days) used to accumulate sleep debt.
DEBT_WINDOW_DAYS = 14

# Debt is paid back gradually, spread across this many nights, rather than all
# in one brutally early bedtime.
DEBT_RECOVERY_NIGHTS = 7

# Hard cap (in minutes) on how much earlier sleep debt may pull your bedtime.
MAX_DEBT_ADJUSTMENT_MINUTES = 45

# --- Guard rails ------------------------------------------------------------

# Never recommend a bedtime outside this window ("HH:MM", local time).
# LATEST_BEDTIME may be after midnight; it is interpreted as the small hours.
EARLIEST_BEDTIME = "21:00"
LATEST_BEDTIME = "01:00"

# --- Calendar output --------------------------------------------------------

# How many nights ahead to plan.
DAYS_AHEAD = 14

# Optional: render all events in this IANA timezone (e.g. "Europe/Zurich").
# Leave as None to use the machine's local timezone.
TIMEZONE = None

# Length (in minutes) of the "Go to bed" event.
BED_EVENT_DURATION_MINUTES = 15

# When to be reminded before bedtime, in minutes. Accepts a single number
# (15), several (60, 15) for a stacked warning, or None for no alarm.
# A comma-separated string ("60,15") works too.
BED_ALARM_MINUTES_BEFORE = (60, 15)

# Add a "Wake up" event as well. Set to False if your alarm clock already
# covers that and you only want the bedtime nudge.
WAKE_EVENT = True

# When to be reminded before wake time, in minutes. Same forms as above;
# 0 means exactly at the wake time. None for no alarm.
WAKE_ALARM_MINUTES_BEFORE = 0
